# 模型配置
MODEL_DIR=models              # 模型目录
DEVICE=cuda                   # 推理设备 (cuda/cpu)
PRELOAD_MODELS=true           # 启动时预加载模型

# OCR 配置
OCR_MODE=auto                 # OCR 模式 (auto/qwen/local/api)
OCR_LANG=ch                   # OCR 语言（仅 local 模式）
USE_ANGLE_CLS=true            # 是否使用角度分类（仅 local 模式）
QWEN_MODEL=qwen3-vl-flash      # Qwen 模型（仅 qwen 模式）
OCR_TIMEOUT=30                # OCR 超时时间（秒）

# Qwen API 配置
DASHSCOPE_API_KEY=            # 阿里云百炼 API Key（qwen 模式需要）

# 质量评估配置
QUALITY_MODE=hybrid           # 质量评估模式 (opencv/qwen/hybrid)

# Qwen 服务列表（JSON 格式）
# 按 priority 从低到高排序，priority 越小优先级越高，依次 failover
# api_key 留空表示本地服务（无需鉴权）
QWEN_SERVICES_JSON=[{"name":"primary","url":"http://localhost:8001/v1/chat/completions","model":"qwen3.5-122b","timeout":30,"enabled":true,"priority":0},{"name":"official","url":"https://api.qwen.com/v1/chat/completions","model":"qwen3.5-plus","api_key":"","timeout":30,"enabled":false,"priority":1},{"name":"aliyun","url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen3-vl-plus","api_key":"","timeout":30,"enabled":false,"priority":2}]

# 服务配置
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=true